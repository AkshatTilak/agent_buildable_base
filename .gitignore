# =============================================================================
# agent_buildable_base — stack-agnostic .gitignore
# -----------------------------------------------------------------------------
# This is the BASE ignore file. It covers OS/editor noise and the assets/
# folder. Per-stack ignore blocks (Python, Node, Go, Rust, etc.) are appended
# by the init_project prompt when a project is bootstrapped, so this file stays
# generic and reusable for ANY project.
# =============================================================================

# -----------------------------------------------------------------------------
# assets/ — user-provided test inputs (pdf, video, audio, scripts, docs).
# These are large and/or user-specific, so they are NOT committed. The
# assets/README.md file is the only tracked file inside assets/.
# -----------------------------------------------------------------------------
assets/*
!assets/README.md

# -----------------------------------------------------------------------------
# OS noise
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.swp
*~
~$*

# -----------------------------------------------------------------------------
# Editor / IDE noise
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.code-workspace
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# -----------------------------------------------------------------------------
# Logs (generic). Project-specific log locations are defined in
# references/logs/ and may add more specific patterns here at init.
# NOTE: references/logs/ is a DOCUMENTATION folder (tracked), not runtime logs.
# -----------------------------------------------------------------------------
*.log
logs/
!references/logs/
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# Environment / secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# -----------------------------------------------------------------------------
# Build / output artifacts (generic)
# -----------------------------------------------------------------------------
build/
dist/
out/
target/
*.tgz
*.tar.gz
*.zip
*.rar
*.7z

# -----------------------------------------------------------------------------
# Caches (generic)
# -----------------------------------------------------------------------------
.cache/
.tmp/
tmp/
*.tmp

# -----------------------------------------------------------------------------
# NOTE: Per-stack ignore blocks are appended below this line by init_project.md
# based on the detected/chosen stack (e.g. Python: __pycache__/, .venv/,
# .pytest_cache/; Node: node_modules/, dist/; etc.).
# -----------------------------------------------------------------------------

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#   JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#   be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#   and can be added to the global gitignore or merged into this file.  For a more nuclear
#   option (not recommended) you can uncomment the following to ignore the entire idea folder.
# .idea/

# Abstra
#   Abstra is an AI-powered process automation framework.
#   Ignore directories containing user credentials, local state, and settings.
#   Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#   Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#   that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#   and can be added to the global gitignore or merged into this file. However, if you prefer, 
#   you could uncomment the following to ignore the entire vscode folder
# .vscode/
# Temporary file for partial code execution
tempCodeRunnerFile.py

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml
